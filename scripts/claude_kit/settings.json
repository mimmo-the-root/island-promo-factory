{
  "hooks": {
    "SessionStart": [
      {
        "_id": "island_session_start",
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/scripts/py.ps1\" session_start.py",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
